+    // Android-Prompt handles PrintScreen on Windows and captures the device
+    // through ADB. Never forward this key through UHID: on Windows/SDL the
+    // release may be delivered only when the scrcpy window loses focus,
+    // which makes Android save an unwanted second screenshot on Alt+2.
+    if (sdl_keycode == SDLK_PRINTSCREEN) {
+        return;
+    }
+
     // Either the modifier includes a shortcut modifier, or the key
     // press/release is a modifier key.
